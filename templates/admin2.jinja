{% set COLORMAP2 = {
    "W": "#D32F2F",
    "K": "#1976D2",
    "P": "#C2185B",
    "L": "#FBC02D"
} %}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="color-scheme" content="light dark">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin - Beta</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 0; padding: 12px; }

        details { margin-bottom: 16px; }
        summary { cursor: pointer; font-weight: 700; padding: 6px 0; }

        table { border-collapse: collapse; min-width: max-content; width: 100%; margin-top: 8px; }
        th, td { white-space: nowrap; padding: 6px 12px; text-align: left; }
        thead th { border-bottom: 2px solid #ccc; text-transform: uppercase; }
        tbody tr:nth-child(even) { background-color: rgba(0,0,0,0.04); }
        tbody tr:hover { background-color: rgba(0,0,0,0.08); }
        th:last-child, td:last-child { text-align: right; font-variant-numeric: tabular-nums; }

        .wrap { max-width: 500px; white-space: normal; }
        .scroll { overflow-x: auto; }

        ul {list-style-type: disc }
    </style>
</head>
<body>
    <h1>Węgielkobus</h1>
{% for line_code, rows in grouped_rows.items() %}
    <details>
        <summary>Linia {{ line_code }} ({{ rows|length }})</summary>

        <div class="scroll">
            <table>
                <thead>
                    <tr>
                        <th>Klasa</th>
                        <th>Imię</th>
                        <th>Treść</th>
                        <th>Data</th>
                        <th>Numer</th>
                    </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    <tr>
                        <td style="color: {{ COLORMAP2.get(row.childClassName[0], '') }}; font-weight: bold;">
                            {{ row.childClassName }}
                        </td>
                        <td>{{ row.childFullName }}</td>
                        <td class="wrap">{{ row.text }}</td>
                        <td>
                            {{ row.dateReceived
                                .replace(tzinfo=zone_info('UTC'))
                                .astimezone(zone_info('Europe/Warsaw'))
                                .strftime('%Y-%m-%d %H:%M:%S') }}
                        </td>
                        <td><a href="tel:{{ row.tel }}">{{ row.tel }}</a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </details>
{% endfor %}

<details>
    <summary>Maile</summary>
    <ol>
    {% for line_code, email_rows in grouped_emails.items() %}
        <li>
            Linia {{ line_code }}
            <ul>
            {% for e in email_rows %}
                {% for addr in e.emails.split(';') %}
                    {% set addr = addr.strip() %}
                    {% if addr %}
                        <li>{{ addr }}</li>
                    {% endif %}
                {% endfor %}
            {% endfor %}
            </ul>
        </li>
    {% endfor %}
    </ol>
</details>

</body>
</html>
